{
  "name": "my-project",
  "version": "3.5.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tranphuong0512/MANAGERPROJECT.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:exe": "next build && node copy-standalone.js && cd .next/standalone && npx electron-builder --win",
    "dev:electron": "electron electron-dev.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "immer": "^11.1.16",
    "lucide-react": "^1.16.0",
    "nanoid": "^6.0.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "react": "^19",
    "react-dom": "^19",
    "react-to-print": "^3.3.0",
    "recharts": "^3.9.2",
    "shadcn": "^4.8.0",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "29.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "build": {
    "appId": "com.quanlyduan.app",
    "productName": "NIX.AI - PROJECT MANAGER",
    "copyright": "Copyright © 2026 NIX.AI - Trần Phương",
    "directories": {
      "output": "dist"
    },
    "files": [
      {
        "from": ".next/standalone",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "server.js",
      "node_modules/**/*",
      ".next/**/*",
      "public/**/*",
      ".env.local"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "maximum",
    "asar": true
  }
}
