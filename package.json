{
  "name": "my-project",
  "version": "3.6.9",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tranphuong0512/MANAGERPROJECT.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "build:exe": "next build && node copy-standalone.js",
    "dev:electron": "electron electron-dev.js",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "immer": "^11.1.18",
    "lucide-react": "^1.33.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.67.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "hono": "4.12.25",
    "fast-uri": ">=3.1.5",
    "uuid": ">=11.1.1"
  },
  "build": {
    "appId": "com.quanlyduan.app",
    "productName": "NIX.AI - PROJECT MANAGER",
    "copyright": "Copyright © 2026 NIX.AI - Trần Phương",
    "directories": {
      "output": "dist"
    },
    "files": [
      {
        "from": ".next/standalone",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "server.js",
      "node_modules/**/*",
      ".next/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Tranphuong0512",
        "repo": "MANAGERPROJECT"
      }
    ]
  }
}